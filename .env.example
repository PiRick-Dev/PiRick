# Copy this file to .env and fill it in. Restart PiRick after changing it.

# ---- First admin account ----------------------------------------------------
# Used only the first time PiRick starts (when it has no users yet). If the
# password is left empty, a random one is printed in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Ollama (the AI) --------------------------------------------------------
# host.docker.internal means "the machine Docker runs on". If Ollama runs in a
# container on the same Docker network, use its name instead: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# Must be a model that supports tool calling ("tools" under Capabilities in
# `ollama show <model>`). PiRick was developed and tested with gemma4:e4b.
OLLAMA_MODEL=gemma4:e4b
# Context window. Search results need room; do not go below 8192.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded after a request, e.g. 30m. Empty = Ollama's default.
OLLAMA_KEEP_ALIVE=
# Only if your Ollama sits behind something that needs a bearer token.
OLLAMA_API_KEY=
# Give up on a reply after this long. Raise it on slow hardware.
OLLAMA_TIMEOUT_SECONDS=300

# ---- Jackett (search) -------------------------------------------------------
JACKETT_URL=http://host.docker.internal:9117
# Shown at the top right of the Jackett dashboard.
JACKETT_API_KEY=
# "all" searches every configured indexer; or give one indexer's id.
JACKETT_INDEXER=all
# How many searches may run at once when planning a whole show. Leave at 1 if any
# indexer goes through FlareSolverr: asked several things together, such indexers
# return far fewer results. Raise it (up to 5) only for fast, direct indexers.
JACKETT_SEARCHES_AT_ONCE=1

# ---- qBittorrent (downloads) ------------------------------------------------
# The Web UI address and login (qBittorrent: Tools > Options > Web UI).
QBIT_URL=http://host.docker.internal:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=

# Where downloads are saved is not set here. Sign in as an admin and add your
# libraries (Movies, TV, Anime, ...) under Admin > Libraries. Nothing can be
# downloaded until at least one exists.

# Refuse downloads larger than this many GB. 0 = no limit.
MAX_TORRENT_SIZE_GB=0

# ---- Web access -------------------------------------------------------------
# Number of reverse proxies in front of PiRick. With one proxy, 1 makes PiRick
# use the visitor's real address for lockouts and mark cookies Secure on HTTPS.
# Set to false if people connect to PiRick directly with no proxy.
TRUST_PROXY=1
# auto = mark the session cookie Secure whenever the visitor arrived over HTTPS.
COOKIE_SECURE=auto
# Signed out after this many days without use, and after this many days regardless.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
