# The VPN that qBittorrent's traffic goes through, for docker-compose.full.yml.
# Copy this file to vpn.env and fill it in. Only the VPN container reads it, so
# PiRick never sees these. Keep the file private: it is excluded from git.
#
# The VPN container is gluetun. It knows most providers, and its wiki lists what
# each one needs: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Choose a provider that allows BitTorrent.

# Your provider, as gluetun names it: mullvad, protonvpn, private internet
# access, nordvpn, surfshark, windscribe, airvpn, ivpn and many more.
VPN_SERVICE_PROVIDER=

# wireguard is faster, where the provider offers it. Otherwise openvpn.
VPN_TYPE=wireguard

# For WireGuard: from a configuration file made in your provider's account.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# For OpenVPN: the OpenVPN (or "manual setup") login, which is often not the
# one you sign in to the provider's website with.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Which servers to use, by country, such as Netherlands or Switzerland. Empty
# leaves it to gluetun.
SERVER_COUNTRIES=

# Some providers let peers reach you through the VPN, which finds more people
# to download from. Set to on where yours does (Private Internet Access and
# ProtonVPN among them), and see the gluetun wiki for passing the port on to
# qBittorrent. Downloads work without it.
VPN_PORT_FORWARDING=off
